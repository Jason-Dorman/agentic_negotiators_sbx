# Environment template. Copy to infra/.env, which is git-ignored, and fill in.
#
#     cp infra/.env.example infra/.env
#
# Rules (docs/security_and_trust_boundaries.md section 7):
#   - This file carries placeholders only. A real value committed here is the incident.
#   - Keys reach the services as references (`env:NAME`, `keystore:/path`), never as values in
#     the database, a log line, an SSE frame or an export.
#   - No secret is ever an argument in a URL.
#
# The stage column says when a variable starts being read. Stage 0 needs none of them: the
# local Compose profile runs on the defaults in infra/compose.local.yaml.

# ---------------------------------------------------------------------------------------
# Database                                                                       (stage 0)
# ---------------------------------------------------------------------------------------
# This project's PostgreSQL is namespaced away from every other stack on the host: its own
# Compose project (`agent_negotiation`), its own named volume
# (`agent_negotiation_postgres_data`), and its own database and role. Renaming any of the three
# below on an existing installation means starting from an empty database, because the volume
# already holds the old one; `make reset-db` is the deliberate way to do that.
POSTGRES_USER=agent_negotiation
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=agent_negotiation

# The published HOST port only. The container always listens on 5432 and nothing changes that.
# The default avoids 5432 because another project or a native install commonly holds it; set
# this to 5432, or to any free port, if that suits your machine better. No application code
# reads this value, so changing it never requires a code change.
POSTGRES_PORT=55432

# Two URLs for two callers, and the difference matters.
#
#   - From the HOST — psql, a migration run from your shell, an IDE, the integration suite when
#     you run it outside Compose — reach the database at 127.0.0.1 on POSTGRES_PORT. Keep the
#     port here in step with POSTGRES_PORT above.
#   - From INSIDE the Compose network — the api service in stage 2 — use the service name and
#     the container port, `postgres:5432`, never the published host port. The api service is
#     given the container-side URL by infra/compose.local.yaml, not by this file.
#
# The `_test` database is created by infra/postgres/init and is the one the integration suite
# uses, so a failed run never leaves the development database dirty. Unset, the suite assumes the
# Compose defaults (password `agent_negotiation`); the Makefile exports both URLs from this file.
# CI and `make ci` set REQUIRE_INTEGRATION=1, under which an unreachable database fails the suite
# instead of skipping it (docs/runbook.md section 2).
DATABASE_URL=postgresql+asyncpg://agent_negotiation:change-me-locally@127.0.0.1:55432/agent_negotiation
TEST_DATABASE_URL=postgresql+asyncpg://agent_negotiation:change-me-locally@127.0.0.1:55432/agent_negotiation_test
# What the backend container will use from stage 2. Host port and service name are independent.
DATABASE_URL_CONTAINER=postgresql+asyncpg://agent_negotiation:change-me-locally@postgres:5432/agent_negotiation

# ---------------------------------------------------------------------------------------
# Chain                                                                          (stage 1)
# ---------------------------------------------------------------------------------------
# Published host port; the container always listens on 8545.
ANVIL_PORT=8545
# From the host. From inside the Compose network the backend uses http://anvil:8545.
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_RPC_URL_CONTAINER=http://anvil:8545
CHAIN_ID=31337
# Sepolia. An Alchemy application created for this project alone, so rate limits and usage are
# attributable to it (Q4, docs/architecture.md sections 4 and 8).      (stage 5)
SEPOLIA_RPC_URL=
# Contract verification only; not used at run time.
ETHERSCAN_API_KEY=

# The RPC the backend's relay and indexer use (stage 2.3). From the host, the Anvil URL above; from
# inside the Compose network, ANVIL_RPC_URL_CONTAINER; on Sepolia, SEPOLIA_RPC_URL.
CHAIN_RPC_URL=http://127.0.0.1:8545
# Seconds before an unanswered RPC call counts as an outage (docs/runbook.md section 6). web3's own
# retries are off, so this is the real limit (ADR-060).
RPC_TIMEOUT_S=10

# Confirmations before an event counts as an economic outcome: 1 locally, 2 on Sepolia
# (Q14). Configurable per run and recorded in the run's export; this is the default for a run that
# does not set one, and for an event whose session belongs to no run.
CONFIRMATION_THRESHOLD=1
# Seconds between indexer polls. 4 on Sepolia (docs/architecture.md section 8).
INDEXER_POLL_INTERVAL_S=1
# The widest block range asked of eth_getLogs at once; hosted RPCs cap it. Alchemy's free tier
# allows 10, which the indexer's re-read of the unfinalized window cannot work within; Pay As You
# Go allows this default (docs/runbook.md section 7, Q40).
INDEXER_LOG_CHUNK_BLOCKS=2000

# The relay's gas policy (stage 2.3). A transaction not included this many blocks after its first
# broadcast is re-signed at the same nonce with both fee caps raised by an eighth (ADR-050)...
RELAY_REPLACE_AFTER_BLOCKS=3
# ...and no fee cap is ever above this, in wei: 100 gwei. At it, replacement stops and waits.
RELAY_MAX_FEE_PER_GAS_WEI=100000000000
# The gas limit for an action the node predicts will revert, which is broadcast anyway so the
# contract decides and the failure has a receipt (ADR-054).
RELAY_FALLBACK_GAS_LIMIT=500000

# The run controller (stage 2.4). An RPC outage — or an agent that does not answer — lasting this
# many seconds moves the run to RECOVERY_REQUIRED; shorter ones are waited out (ADR-063, ADR-064).
RPC_OUTAGE_LIMIT_S=60
# Seconds a run's lease lasts unless renewed; the driver renews it at a third of this. A restarted
# backend takes the run over once the old process's lease has expired (docs/runbook.md section 6).
RUN_LEASE_TTL_S=30
# Seconds a call to an agent other than a turn may take. A turn's limit is the run's own
# model_timeout_s for each attempt it may make, plus slack.
AGENT_TIMEOUT_S=10
# Recorded on every run as runs.software_version.
SOFTWARE_VERSION=0.1.0

# ---------------------------------------------------------------------------------------
# Keys — all test-network keys. Nothing here is production custody.            (stage 2)
# ---------------------------------------------------------------------------------------
# Generated once per deployment, not per run (docs/runbook.md section 3):
#   uv run --group tooling python infra/scripts/generate_keys.py --profile local
# Local profile: `env:` refs to the variables below. Sepolia profile: `keystore:` refs to
# encrypted web3 keystore JSON in infra/secrets/, unlocked with KEYSTORE_PASSWORD (ADR-023).
#
# Pays gas. Cannot produce a participant signature (docs/security_and_trust_boundaries.md 4).
# Both backend keys are references in the grammar the agents' roots use (ADR-049); a key pasted
# here in place of its reference stops the backend starting, and the error does not repeat it.
RELAY_KEY_REF=env:RELAY_PRIVATE_KEY
RELAY_PRIVATE_KEY=
# Creates and aborts sessions.
OPERATOR_KEY_REF=env:OPERATOR_PRIVATE_KEY
OPERATOR_PRIVATE_KEY=
# The two agents' ROOT secrets (ADR-039), from stage 2.2. A root never signs and is never
# funded: each agent derives a fresh participant key from its root for every run, from the
# chain ID, its role and the run ID, and reports only the address. Each root reaches exactly
# one agent instance and never the other; the backend holds only the references.
BUYER_ROOT_KEY_REF=env:BUYER_ROOT_KEY
BUYER_ROOT_KEY=
SELLER_ROOT_KEY_REF=env:SELLER_ROOT_KEY
SELLER_ROOT_KEY=
# Unlocks the keystore files in infra/secrets/ under the Sepolia profile.       (stage 5)
KEYSTORE_PASSWORD=

# ---------------------------------------------------------------------------------------
# Agent services — one set per instance; the two never share a value.           (stage 2)
# ---------------------------------------------------------------------------------------
AGENT_A_URL=http://agent-a:8101
AGENT_B_URL=http://agent-b:8102
# HMAC-SHA256 shared secret per instance, over method, path and body (docs/api_contract.md
# section 6, ADR-041). At least 32 characters; an instance refuses to start with less.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AGENT_A_SHARED_SECRET=
AGENT_B_SHARED_SECRET=
# Upper bound on the gas limit of a participant's setup `approve` (ADR-042), and on its worst-case
# cost, gas limit times fee cap, in wei: 0.01 ETH (ADR-047). Both instances, and the backend, which
# never asks for more gas than the first and funds each wallet with exactly the approval's worst
# case (ADR-065).
AGENT_SETUP_GAS_LIMIT_MAX=100000
AGENT_SETUP_MAX_COST_WEI=10000000000000000
#
# Each agent process reads only AGENT_* variables plus the one its root reference names. From
# stage 2.5 Compose maps the values above onto each container; by hand (docs/runbook.md 3):
#   agent-a: AGENT_ROLE=buyer  AGENT_INSTANCE=agent-a AGENT_PORT=8101
#            AGENT_ROOT_KEY_REF=$BUYER_ROOT_KEY_REF  AGENT_SHARED_SECRET=$AGENT_A_SHARED_SECRET
#            BUYER_ROOT_KEY=$BUYER_ROOT_KEY
#   agent-b: AGENT_ROLE=seller AGENT_INSTANCE=agent-b AGENT_PORT=8102
#            AGENT_ROOT_KEY_REF=$SELLER_ROOT_KEY_REF AGENT_SHARED_SECRET=$AGENT_B_SHARED_SECRET
#            SELLER_ROOT_KEY=$SELLER_ROOT_KEY
# Model credentials, held separately per instance so one agent's spend and one agent's
# credential are never the other's.                                             (stage 3)
AGENT_A_ANTHROPIC_API_KEY=
AGENT_B_ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------------------
# Model                                                                         (stage 3)
# ---------------------------------------------------------------------------------------
# ADR-014. Recorded per run in runs.model_id; server-side fallbacks are off so the recorded
# model is the model that decided (ADR-015).
MODEL_ID=claude-opus-5
MODEL_EFFORT=high
MODEL_TIMEOUT_S=45
MODEL_CALL_CEILING=20
MODEL_SPEND_CEILING_USD=2.00
MODEL_REPAIR_ATTEMPTS=1

# ---------------------------------------------------------------------------------------
# Backend                                                                       (stage 2)
# ---------------------------------------------------------------------------------------
# Where `python -m api` listens when run from the host. In Compose the container listens on 0.0.0.0
# and API_PORT is the published host port, bound to 127.0.0.1.
API_HOST=127.0.0.1
API_PORT=8000
# Static bearer token on every route except health (ADR-028). Leave empty only while bound to
# localhost; exposing the UI further requires the review in
# docs/security_and_trust_boundaries.md section 8.1.
OPERATOR_TOKEN=
LOG_LEVEL=INFO

# The operator API (stage 2.5). `python -m api` reads DATABASE_URL above. Compose sets the next
# two itself: the manifest the `deploy` service wrote, and the scenarios copied into the image.
#   DEPLOYMENT_MANIFEST  the deployment this backend serves; validated and upserted at start-up
#   SCENARIOS_DIR        every scenario template, validated and upserted at start-up
DEPLOYMENT_MANIFEST=docs/deployments/local-2026-10-02-01.json
SCENARIOS_DIR=scenarios
# Apply the migrations at start-up: the local profile does, a Sepolia host runs them by hand
# (docs/data_model.md section 8).
AUTO_MIGRATE=false
# Which entry of the RPC price table prices this deployment's requests, and an operator's own
# table in place of the packaged one, which prices only `anvil` (ADR-061, ADR-075). A provider the
# table does not list shows its cost as unknown, never zero.
RPC_PROVIDER=anvil
RPC_PRICE_TABLE=
# How often an event stream and an operation look for new run events, in seconds; a keepalive
# comment after this many seconds without an event; and how long an idempotency key is kept, in
# hours (docs/api_contract.md sections 1 and 3).
EVENT_POLL_INTERVAL_S=0.25
SSE_KEEPALIVE_S=15
IDEMPOTENCY_RETENTION_H=24
